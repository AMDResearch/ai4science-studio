# Python
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/
env/
*.egg-info/
.eggs/
dist/
build/

# Jupyter
.ipynb_checkpoints/

# ML / checkpoints (keep recipes; ignore large artifacts)
*.ckpt
*.pt
*.pth
*.safetensors
*.bin
checkpoints/
wandb/
mlruns/

# OS / editor
.DS_Store
Thumbs.db
*.swp
*.swo

# Secrets — never commit
.env
.env.*
*.pem
secrets/
**/env_file

# Containers & overlays
*.sif
*.img
*-overlay-scripts/
*-stage/

# SLURM job output
*-*.out
# SLURM job artifacts named foo.<jobid>.out (e.g. omnistat_failed_hosts.6851.out)
*.[0-9][0-9][0-9][0-9].out

# Misc tooling artifacts emitted into repo root by past omnistat / VM runs
exporter.log
vic_server.log

# Convergence parser outputs (artifact, not source)
**/examples/convergence*.png
**/examples/convergence*.csv
**/examples/scaling_study*
**/examples/foms-*.json

# Model outputs & generated data
**/examples/outputs/
**/examples/generated.csv

# Local cluster config (site-specific, auto-created by agent)
.cluster-config.yaml

# Studio web GUI — local venv and per-user job state
studio/.venv/
studio/.studio-jobs.*.json

# Session-scoped agent handoff files (ephemeral, not for the repo)
HANDOFF.md
.claude/settings.local.json
nul

# IDE
.idea/
.vscode/

# Stray SLURM stdout from perf runs (real logs live under perf-runs/<jobid>/)
orbit2-train-*.out
