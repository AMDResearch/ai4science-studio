# Python
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/
env/
*.egg-info/
.eggs/
dist/
build/

# Jupyter
.ipynb_checkpoints/

# ML / checkpoints (keep recipes; ignore large artifacts)
*.ckpt
*.pt
*.pth
*.safetensors
*.bin
checkpoints/
wandb/
mlruns/

# OS / editor
.DS_Store
Thumbs.db
*.swp
*.swo

# Secrets — never commit
.env
.env.*
*.pem
secrets/
**/env_file

# Containers & overlays
*.sif
*.img
*-overlay-scripts/
*-stage/

# SLURM job output
*-*.out
# SLURM job artifacts named foo.<jobid>.out (e.g. omnistat_failed_hosts.6851.out)
*.[0-9][0-9][0-9][0-9].out

# Misc tooling artifacts emitted into repo root by past omnistat / VM runs
exporter.log
vic_server.log

# Convergence parser outputs (artifact, not source)
**/examples/convergence*.png
**/examples/convergence*.csv
**/examples/scaling_study*
**/examples/foms-*.json

# Model outputs & generated data
**/examples/outputs/
**/examples/generated.csv

# Local cluster config (site-specific, auto-created by agent)
.cluster-config.yaml

# Session-scoped agent handoff files (ephemeral, not for the repo)
HANDOFF.md
.claude/settings.local.json
nul

# Local run artifacts (SLURM stdout, ad-hoc logs). Prefer this over dumping *.out at repo root.
runs/

# IDE
.idea/
.vscode/

# Stray SLURM stdout from perf runs (real logs live under perf-runs/<jobid>/)
orbit2-train-*.out

# ── Studio web application ────────────────────────────────────────────────────

# Frontend build output and dependencies (regenerate with npm install / npm run build)
studio/frontend/dist/
studio/frontend/node_modules/

# Backend runtime artifacts (ephemeral job output, SQLite state, bytecode)
studio/backend/runs/
studio/backend/studio.db
studio/backend/__pycache__/
studio/backend/tools/__pycache__/

# Demo large media — videos > 1 MB and screenshot grids (keep scripts, not outputs)
studio/demo/demo-output/*.mp4
studio/demo/demo-output/*.webm
studio/demo/demo-output/shots/
studio/demo/demo-output/backend_*.log
studio/demo/demo-output/frontend_*.log
studio/demo/node_modules/

# Baked data assets (large, regenerable via tools/bake_*.py — see assets/README.md)
studio/backend/assets/*.json

# GHSL global built-up GeoTIFF cache (129 MB, re-downloadable via fetch_dc_urban_density.py)
studio/backend/assets/_ghsl_builtup_dc.tif

# Stray demo capture logs
studio/demo/demo-output/*.log
studio/scripts/demo/*.log

# ── LaTeX documentation ───────────────────────────────────────────────────────
# Keep .tex source, .bib, Makefile; ignore compiled artifacts and binaries
docs/*.pdf
docs/*.aux
docs/*.bbl
docs/*.blg
docs/*.log
docs/*.out
docs/*.toc
docs/*.lof
docs/*.lot
docs/*.fls
docs/*.fdb_latexmk
docs/*.synctex.gz
docs/*.xdv
docs/*-blx.bib
docs/*.bcf
docs/*.run.xml

# ── Root-level site-specific SLURM overlay build scripts ─────────────────────
# These reference absolute paths for a specific cluster; not portable.
# The canonical templates live in each model's examples/ directory.
build_*.slurm
build_*.log

# Demo capture job logs (per-run, ephemeral)
studio/scripts/demo/capture_demo_*.log
studio/demo/studio_demo_*.log
