# AI4Science Studio site configuration.
#
# Copy to studio/.env (gitignored) and fill in the values for your cluster.
# The backend loads studio/.env at startup; variables already set in the
# environment take precedence. For hand-submitted sbatch scripts, export the
# same values first:   set -a; . studio/.env; set +a
#
# Demo (replay) mode needs none of these. Live SLURM runs need at least
# AI4S_SHARED_DIR and a partition. ${VAR} references are expanded.

# Site shared directory: container images, overlays, weights, run output.
AI4S_SHARED_DIR=

# SLURM defaults for live runs launched from the Studio.
AI4S_SLURM_PARTITION=
AI4S_SLURM_ACCOUNT=

# Standard sbatch variables: override the YOUR_PARTITION_HERE / YOUR_ACCOUNT_HERE
# placeholders in the committed #SBATCH headers when you submit by hand after
# `set -a; . studio/.env; set +a`. The backend ignores them for its own jobs.
# SBATCH_PARTITION=${AI4S_SLURM_PARTITION}
# SBATCH_ACCOUNT=${AI4S_SLURM_ACCOUNT}

# Optional overrides (defaults shown).
# AI4S_SIF=${AI4S_SHARED_DIR}/images/pytorch_rocm7.2.2_ubuntu24.04_py3.12_pytorch_release_2.10.0.sif
# PERF_TOOLS_DIR=${AI4S_SHARED_DIR}/perf-tools
# HG_BASE=${AI4S_SHARED_DIR}/models/HydraGNN
# HG_DATA_DIR=${HG_BASE}/weights
# ORBIT2_BASE=${AI4S_SHARED_DIR}/models/ORBIT-2
# ORBIT2_ROOT=${ORBIT2_BASE}/code/ORBIT-2
# ORBIT2_HF_CACHE=${HOME}/.cache/huggingface/orbit2
# ORBIT2_SR_DIR=${AI4S_SHARED_DIR}/orbit2_sr
# GPMOL_BASE=${AI4S_SHARED_DIR}/models/GP-MoLFormer

# Node-local scratch for the demo recorders' staged Chromium.
# AI4S_LOCAL_SCRATCH=/tmp/${USER}

# Demo recorder / launcher helpers (only printed or used by the named scripts).
# STUDIO_HOST=            # demo/record_demo.slurm: host (IP) running the services
# STUDIO_LOGIN_HOST=      # launch-local.sh: login node name for the laptop tunnel
# STUDIO_PUBLIC_URL=      # launch-local.sh: public URL, if a tunnel is configured
