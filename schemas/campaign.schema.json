{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai4science-studio.local/schemas/campaign.schema.json",
  "title": "AI4Science Studio campaign.yaml",
  "description": "Declarative campaign: ordered stages with typed inputs/outputs and failure gating.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "stages"],
  "properties": {
    "schema_version": { "type": "string", "const": "1" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["string", "path", "integer", "number", "boolean", "object"]
          },
          "default": {},
          "required": { "type": "boolean" },
          "description": { "type": "string" },
          "env": { "type": "string", "description": "Environment variable that may supply this input." }
        }
      }
    },
    "llm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["external", "local", "auto"],
          "default": "auto"
        },
        "endpoint": { "type": "string" },
        "api_key_env": { "type": "string", "default": "OPENAI_API_KEY" },
        "auth_style": {
          "type": "string",
          "enum": ["auto", "bearer", "apim"],
          "default": "auto",
          "description": "auto selects apim (Ocp-Apim-Subscription-Key) for llm-api.amd.com, else bearer."
        },
        "model": { "type": "string" },
        "local": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "image": { "type": "string" },
            "model": { "type": "string" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "gpus": { "type": "integer", "minimum": 1, "default": 1 }
          }
        }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/stage" }
    }
  },
  "$defs": {
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "ref"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["task", "agent"] },
        "ref": {
          "type": "string",
          "minLength": 1,
          "description": "task: model:recipe (e.g. ORBIT-2:inference). agent: reusable agent name (e.g. perf-report)."
        },
        "command": {
          "type": "string",
          "description": "Optional override command/script path relative to repo root."
        },
        "required_for_next": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Artifact keys that must validate before the next stage may run on partial."
        },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    }
  }
}
