{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai4science-studio.local/schemas/agent.schema.json",
  "title": "AI4Science Studio reusable agent.yaml",
  "description": "Reusable agent definition for the repo catalog and optional cluster registry. Campaign-specific artifacts do not belong here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "kind", "version", "description"],
  "properties": {
    "schema_version": { "type": "string", "const": "1" },
    "name": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "const": "agent" },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "llm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": { "type": "boolean", "default": false },
        "model_alias": { "type": "string" }
      }
    },
    "playbook": { "type": "string" },
    "entry": {
      "type": "string",
      "description": "Python entry dotted path or script relative to the agent directory."
    },
    "allow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tools": { "type": "array", "items": { "type": "string" } },
        "commands": { "type": "array", "items": { "type": "string" } },
        "submit_jobs": { "type": "boolean", "const": false }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type"],
        "properties": {
          "type": { "type": "string" },
          "required": { "type": "boolean" },
          "description": { "type": "string" }
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type"],
        "properties": {
          "type": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    }
  }
}
